{
  "name": "backend",
  "version": "2.0.0",
  "description": "Code Club API server",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "nodemon --exec \"node --import ./instrument.js\" --ext js,mjs,json,env server.js",
    "start": "node server.js",
    "seed": "node scripts/seedProblems.js",
    "seed:code-club-edition": "node scripts/seedCodeClubEdition.js",
    "validate:problems": "node scripts/validateProblemContracts.js",
    "audit:problems-languages": "node scripts/auditProblemsAgainstLanguageRegistry.js",
    "problems:export-to-folders": "node scripts/exportProblemsToFolders.js",
    "problems:import-from-folders": "node scripts/importProblems.js",
    "backfill-xp": "node scripts/backfillXP.js",
    "backfill-roles": "node scripts/backfillAuthorizedRoles.js",
    "backfill-roles:dry-run": "node scripts/backfillAuthorizedRoles.js --dry-run",
    "migrate:college-schema": "node scripts/migrateCollegeSchema.js",
    "migrate:college-schema:dry-run": "node scripts/migrateCollegeSchema.js --dry-run",
    "weekly-review": "node scripts/sendWeeklyReviewEmails.js",
    "weekly-review:dry-run": "node scripts/sendWeeklyReviewEmails.js --dry-run",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.107.0",
    "@google/genai": "^2.18.0",
    "@sentry/node": "^10.63.0",
    "cors": "^2.8.6",
    "csv-parse": "^6.2.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.2.0",
    "ioredis": "^5.4.1",
    "mongodb": "^7.2.0",
    "mongoose": "^9.6.2",
    "multer": "^2.4.0",
    "pdfkit": "^0.19.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.3",
    "razorpay": "^2.9.4",
    "resend": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.7",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.14",
    "vitest": "^3.2.4"
  }
}
