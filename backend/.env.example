# ── Code Club Backend — environment variables ──────────────────────────────────
# Copy this file to backend/.env and fill in real values.
# ONE variable per line. No quotes needed unless the value contains spaces.

1. PORT=5000

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Get from Atlas → Connect → Drivers. Include the database name before the ?.
# Example: mongodb+srv://USER:PASSWORD@cluster0.abcde.mongodb.net/codeclimb?retryWrites=true&w=majority
2. MONGODB_URI=

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
# Get all three from Firebase Console → Project Settings → Service Accounts
# → Generate new private key → open the JSON file.
3. FIREBASE_PROJECT_ID=
4. FIREBASE_CLIENT_EMAIL=
5. FIREBASE_PRIVATE_KEY=

# ── Judge0 ────────────────────────────────────────────────────────────────────
# Public instance (rate-limited). For production, use a dedicated instance.
6. JUDGE0_API_URL=https://ce.judge0.com/submissions?base64_encoded=true&wait=true
7. JUDGE0_API_KEY=
8. JUDGE0_RAPIDAPI_KEY=

# ── Redis (optional) ──────────────────────────────────────────────────────────
# Shared cache for /api/problems, /api/leaderboard, /api/public/:username.
# Leave blank to run without it — each backend instance falls back to its
# own in-memory cache (fine for a single Railway instance; set this once
# you run more than one, so all instances agree on cached data).
# Railway: add the Redis plugin, it injects REDIS_URL automatically.
# Upstash: copy the "ioredis"-compatible connection string from the console.
REDIS_URL=

# ── CORS ──────────────────────────────────────────────────────────────────────
# The frontend origin Railway/Vercel should allow. In dev this is unused.
9. FRONTEND_URL=https://code-club-one.vercel.app

# ── Support contact ───────────────────────────────────────────────────────────
# Shown in TPO early-access messaging and PDF export footers
# (backend/config/site.js). Not a real inbox by default — set this once one
# exists, ideally on your real domain once FRONTEND_URL points there too.
10. SUPPORT_EMAIL=hello@codeclub.in

# ── Sentry error monitoring ───────────────────────────────────────────────────
# Get DSN from sentry.io → Your Project → Settings → Client Keys.
# Leave blank to disable Sentry (no crash, just no error reporting).
11. SENTRY_DSN=

# ── AI Coaching (Claude) ──────────────────────────────────────────────────────
# Get from console.anthropic.com → API Keys
12. ANTHROPIC_API_KEY=

# ── Weekly AI review email (commit 097) ───────────────────────────────────────
# Get from resend.com → API Keys. Leave blank to disable — the weekly-review
# script will log a warning and exit without sending anything.
13. RESEND_API_KEY=
# Must be on a domain you've verified in Resend, e.g. "Code Club <reviews@yourdomain.com>".
# Falls back to Resend's shared onboarding@resend.dev sender (fine for testing,
# more likely to land in spam for real sends) if left blank.
14. RESEND_FROM_EMAIL=

# ── Node environment ──────────────────────────────────────────────────────────
15. NODE_ENV=development

# ── Monetization (Phase 6) ─────────────────────────────────────────────────
# Master switch — keep "false" until you're ready to charge real users.
# Everyone is treated as premium while this is false. No code changes needed
# to flip it on later — just set to "true" in production env vars.
16. MONETIZATION_ENABLED=false

# B2B / TPO dashboard — can be enabled independently of consumer billing.
17. B2B_ENABLED=false

# 18. TPO institution billing enforcement — keep false during free pilots.
18. B2B_BILLING_ENABLED=false

# ── Reward Policy (Phase 2 — Contribution Infrastructure + Referral System) ──
# Deliberately left UNSET. Code Club's token economy (amounts, not just the
# existence of rewards) has not been finalized. Until these are set, any
# reward-issuing code path (referral qualification, contribution approval)
# logs a warning and skips issuing that specific reward rather than guessing
# a number — see backend/config/rewardPolicy.js for why. Set these only once
# real amounts have been decided.
# REWARD_AMOUNT_CONTRIBUTION_APPROVED=
# REWARD_AMOUNT_REFERRAL_QUALIFIED_REFERRER=
# REWARD_AMOUNT_REFERRAL_QUALIFIED_REFERRED=
# REWARD_AMOUNT_FEATURE_REQUEST_SHIPPED=

# Razorpay (get from razorpay.com dashboard → Settings → API Keys)
18. RAZORPAY_KEY_ID=
19. RAZORPAY_KEY_SECRET=
20. RAZORPAY_WEBHOOK_SECRET=
21. RAZORPAY_B2B_WEBHOOK_SECRET=
